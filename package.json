    "typecheck": "tsc -b"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "mathjs": "^14.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.53.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^4.1.1",
    "globals": "^16.0.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  }
